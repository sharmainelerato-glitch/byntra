# Optional. A long random secret is recommended for production.
BYNTRA_SECRET=replace-with-a-long-random-secret
# Set frontend origins, separated by commas, for deployed use.
BYNTRA_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional real Gemini API integration (not needed for basic app)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
